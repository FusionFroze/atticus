{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atticus",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  // Logs on, so `npx wrangler tail` and the dashboard show each run.
  "observability": { "enabled": true },
  // How often Atticus checks Google Play. Every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Your D1 database. Put the id that `npx wrangler d1 create atticus` printed (README → Deploy).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atticus",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Replace every REPLACE_WITH_… value (README → Deploy, Configuration).
  // In `npx wrangler tail`, a Discord value left as it is shows as a config_invalid that
  // names it, and a package name left as it is shows as poll_failed with not_found.
  // The two secrets never go here: use `npx wrangler secret put` (README → Deploy).
  "vars": {
    "APPS": [
      {
        "store": "play",
        "id": "REPLACE_WITH_PACKAGE_NAME",
        "name": "REPLACE_WITH_APP_NAME"
      }
    ],
    "DISCORD_APPLICATION_ID": "REPLACE_WITH_APPLICATION_ID",
    "DISCORD_PUBLIC_KEY": "REPLACE_WITH_PUBLIC_KEY",
    "DISCORD_CHANNEL_ID": "REPLACE_WITH_CHANNEL_ID",
    "ALLOWED_USER_IDS": "REPLACE_WITH_YOUR_USER_ID",
    "TIMEZONE": "UTC"
  },
  // The maintainers' test Worker (`npm run deploy:dev`). Ignore it for your own deploy.
  // Bindings are not inherited, so env.dev repeats vars. DRY_RUN stays on there (V80).
  "env": {
    "dev": {
      "name": "atticus-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "atticus-dev",
          "database_id": "1fd22e57-e524-4f6a-a15e-d95ba32eb398",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APPS": [
          {
            "store": "play",
            "id": "com.fusionfroze.Lune",
            "name": "Lune",
            "consoleUrl": "https://play.google.com/console/u/0/developers/7040399675484853745/app/4973690844678006441/user-feedback/reviews"
          }
        ],
        "DISCORD_APPLICATION_ID": "1561570492916301894",
        "DISCORD_PUBLIC_KEY": "0da3a5d985950d0c09e64c11fc740625734f0e558dcf8164f61b07d28f1d4fd8",
        "DISCORD_CHANNEL_ID": "1561569716714209422",
        "ALLOWED_USER_IDS": "1097036371643867146",
        "TIMEZONE": "Asia/Kolkata",
        "DRY_RUN": true
      }
    }
  }
}
