# Only for running Atticus locally with `npm run dev`. A deployed Worker never reads
# this file: deployed secrets go in with `npx wrangler secret put` (README → Deploy).
# Copy this file to .dev.vars, which is gitignored. Never commit a real key.
# A value here overrides the matching var in wrangler.jsonc, for `npm run dev` only.

# The whole Google service-account JSON key, on one line.
# Only client_email and private_key are read.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"name@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"}

# Discord application → Bot → Token.
DISCORD_BOT_TOKEN=replace-me

# Everything below is optional here: wrangler.jsonc already sets these vars.
# Uncomment a line to use a different value locally, for example a test channel.
# Warning: with a real bot token and a real channel id, `npm run dev` posts to that channel.

# APPS=[{"store":"play","id":"com.example.app","name":"Example"}]
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_CHANNEL_ID=
# ALLOWED_USER_IDS=
# TRANSLATION_LANGUAGE=en
# BACKFILL=post
# PING_ON_LOW_RATING=&400000000000000000
# TIMEZONE=UTC
# DIGEST_ENABLED=true
# DIGEST_DAY=mon
# DIGEST_HOUR=9
# DRY_RUN=true
